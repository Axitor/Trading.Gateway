<Project Sdk="Microsoft.NET.Sdk">

    <!--
    Tests in this project hit the real exchange. They are never run by CI:
    the workflow invokes the Axitor.Trading.Gateway.Tests project explicitly and this one
    is not in that list. Run it locally with credentials in the environment.
    Order placement belongs in the fake exchange, never here.
    The test order endpoint is allowed: the exchange validates it and places nothing.
    The leverage test moves the BTCUSDT leverage one step and sets it back.
  -->
    <PropertyGroup>
        <RootNamespace>Axitor.Trading.Gateway.Tests.Live</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Core/Axitor.Trading.Gateway.Core/Axitor.Trading.Gateway.Core.csproj" />
        <ProjectReference Include="../../src/Connectors/Axitor.Trading.Gateway.Binance/Axitor.Trading.Gateway.Binance.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

</Project>